{
  "expo": {
    "name": "Nexora Employee",
    "slug": "nexora-employee",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "nexora",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0A0C10"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nexora.employee",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock the Nexora Employee app with Face ID.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.nexora.employee",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E3141B"
      },
      "permissions": []
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#0A0C10"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://nexora-hrms.up.railway.app",
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Nexora Employee",
      "shortName": "Nexora",
      "themeColor": "#E3141B",
      "backgroundColor": "#0A0C10",
      "display": "standalone",
      "orientation": "portrait",
      "description": "Nexora HRMS employee self-service: leave, payslips, letters and requests."
    }
  }
}